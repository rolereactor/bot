{
  "type": "module",
  "name": "bot",
  "version": "1.8.0",
  "description": "Discord bot for server management with role assignment, AI image generation, and community engagement features.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:safe": "pkill -f 'node src/index.js' 2>/dev/null || true; lsof -ti:3030 | xargs kill -9 2>/dev/null || true; sleep 1 && node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:safe": "pkill -f 'node src/index.js' 2>/dev/null || true; lsof -ti:3030 | xargs kill -9 2>/dev/null || true; sleep 1 && nodemon src/index.js",
    "type-check": "tsc --noEmit -p jsconfig.json 2>&1 | grep -v 'node_modules/' || true",
    "deploy:dev": "NODE_ENV=development node scripts/deploy-commands.js",
    "deploy:prod": "NODE_ENV=production node scripts/deploy-commands.js",
    "delete:commands": "node scripts/delete-commands.js",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "pre-commit": "lint-staged",
    "docker:build": "docker build -t role-reactor-bot .",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:logs": "docker compose -f docker-compose.prod.yml logs -f --tail=50",
    "docker:status": "docker compose -f docker-compose.prod.yml ps",
    "docker:restart": "docker compose -f docker-compose.prod.yml restart",
    "docker:deploy": "./scripts/deploy-latest.sh",
    "docker:deploy:verbose": "./scripts/deploy-latest.sh --verbose",
    "pm2:setup": "./scripts/setup-pm2.sh",
    "pm2:deploy": "./scripts/deploy-pm2.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop role-reactor-bot",
    "pm2:restart": "pm2 restart role-reactor-bot",
    "pm2:logs": "pm2 logs role-reactor-bot",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit"
  },
  "author": {
    "name": "tyecode",
    "email": "sengphachanh.dev@gmail.com",
    "url": "https://github.com/tyecode"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/rolereactor/bot.git"
  },
  "bugs": {
    "url": "https://github.com/rolereactor/bot/issues"
  },
  "homepage": "https://rolereactor.xyz",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.9.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.92",
    "@top-gg/sdk": "3.1.6",
    "axios": "1.13.2",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "connect-mongo": "5",
    "dedent": "1.6.0",
    "discord.js": "14.22.1",
    "dotenv": "^16.3.1",
    "emoji-regex": "10.4.0",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "express-session": "1.18.2",
    "gradient-string": "^3.0.0",
    "mongodb": "^6.17.0",
    "multer": "^1.4.5-lts.1",
    "ora": "^8.2.0",
    "p-limit": "6.2.0",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "tmi.js": "^1.8.5",
    "viem": "^2.56.3",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/busboy": "^1.5.4",
    "@types/concat-stream": "^2.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.2.0",
    "@types/type-is": "^1.6.7",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "node-fetch": "3.3.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.0",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas"
    ]
  }
}
